<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="GtktextWindow" parent="GtkApplicationWindow">
    <property name="default-width">600</property>
    <property name="default-height">400</property>

    <!-- 1. BARRE DE TITRE MODERNE AVEC ICÔNES SYMBOLIQUES -->
    <child type="titlebar">
      <object class="GtkHeaderBar" id="barre_titre">
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">PyText</property>
          </object>
        </property>

        <!-- Bouton Ouvrir (à gauche) -->
        <child type="start">
          <object class="GtkButton" id="bouton_ouvrir">
            <property name="icon-name">document-open-symbolic</property>
            <property name="tooltip-text">Ouvrir un fichier texte</property>
            <signal name="clicked" handler="on_bouton_ouvrir_clicked"/>
          </object>
        </child>

        <!-- Bouton Statistiques (à droite) -->
        <child type="end">
          <object class="GtkButton" id="bouton_action">
            <property name="icon-name">dialog-information-symbolic</property>
            <property name="tooltip-text">Analyser le texte (mots et caractères)</property>
            <signal name="clicked" handler="on_bouton_action_clicked"/>
          </object>
        </child>

        <!-- Bouton Enregistrer (à droite) -->
        <child type="end">
          <object class="GtkButton" id="bouton_enregistrer">
            <property name="icon-name">document-save-symbolic</property>
            <property name="tooltip-text">Enregistrer le fichier sous...</property>
            <signal name="clicked" handler="on_bouton_enregistrer_clicked"/>
          </object>
        </child>
      </object>
    </child>

    <!-- 2. CORPS DE LA FENÊTRE -->
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>

        <!-- Zone de texte avec défilement -->
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="has-frame">true</property>
            <child>
              <object class="GtkTextView" id="zone_texte">
                <property name="wrap-mode">word</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
                <property name="top-margin">8</property>
                <property name="bottom-margin">8</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Label de statut inférieur -->
        <child>
          <object class="GtkLabel" id="label_info">
            <property name="label">Prêt...</property>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>

